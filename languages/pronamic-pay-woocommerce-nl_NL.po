#. Plugin Name of the plugin
#: pronamic-pay-woocommerce.php:3
msgid "Pronamic Pay WooCommerce Add-On"
msgstr "Pronamic Pay WooCommerce Add-On"

#. Plugin URI of the plugin
#: pronamic-pay-woocommerce.php:4
msgid "https://www.pronamic.eu/plugins/pronamic-pay-woocommerce/"
msgstr "https://www.pronamic.eu/plugins/pronamic-pay-woocommerce/"

#. Description of the plugin
#: pronamic-pay-woocommerce.php:5
msgid "Extend the Pronamic Pay plugin with WooCommerce support to receive payments through a variety of payment providers."
msgstr "Breid de Pronamic Pay plugin uit met WooCommerce-ondersteuning om betalingen te ontvangen via diverse betaalproviders."

